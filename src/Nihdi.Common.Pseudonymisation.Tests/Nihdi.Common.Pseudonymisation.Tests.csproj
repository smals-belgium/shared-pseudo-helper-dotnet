<Project Sdk="Microsoft.NET.Sdk">

  <!-- Debugging a test by right-clicking it in the editor runs it on every target framework
       below, one after the other, and the debugger cannot attach to the .NET Framework host: the
       run then sits there doing nothing until you kill it, and only then reaches your breakpoint.
       Debug from the Test Explorer instead. It lists the test once per target framework, so you
       pick the one you want and only that one runs. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
  </PropertyGroup>

  <!-- Exclude .NET Framework 4.8 builds on non-Windows systems -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

	<PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IdentityModelVersion Condition="'$(IdentityModelVersion)' == ''">8.23.0</IdentityModelVersion>
    <!--<GenerateAssemblyInfo>false</GenerateAssemblyInfo>   
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>-->
      <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- The library is built against Microsoft.IdentityModel.Tokens 7.6.2, but an application that already uses 8.x
         resolves it to 8.x at run time. Some APIs that are public in 7.x are internal in 8.x, and the compiler
         cannot see that: only running the tests against 8.x does. By default the tests run against 8.x; to run
         them against the floor the package declares, pass -p:IdentityModelVersion=7.6.2. -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
  </ItemGroup>

  <!-- Polyfills for .NET Framework: these APIs ship in-box on net8.0 and net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nihdi.Common.Pseudonymisation\Nihdi.Common.Pseudonymisation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\domain.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
