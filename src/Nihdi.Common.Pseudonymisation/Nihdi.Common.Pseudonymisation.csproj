<Project Sdk="Microsoft.NET.Sdk">

	<!-- net48 was dropped before 1.0.0. Restoring it takes more than adding it back here: see doc/restoring-net48.md. -->
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<LangVersion>12.0</LangVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageTags></PackageTags>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>RIZIV-INAMI</Authors>
		<Description>A .NET library that helps integrators interact with the eHealth Pseudonymisation service.</Description>
		<Title>Pseudonymisation Helper</Title>
		<Summary>eHealth Pseudonymisation Helper</Summary>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/smals-belgium/shared-pseudo-helper-dotnet</PackageProjectUrl>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/smals-belgium/shared-pseudo-helper-dotnet</RepositoryUrl>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>SA1305</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.6.2" />
	</ItemGroup>
</Project>
